{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://mindvault-6ff3.onrender.com/api/:path*"
    },
    {
      "source": "/downloads/:path*",
      "destination": "https://mindvault-6ff3.onrender.com/downloads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}